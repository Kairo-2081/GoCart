GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.[cite: 1]
APP_URL="***REMOVED***"

# Database Credentials
DB_USER="postgres"
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_NAME="postgres"
DB_PASSWORD="postgres"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"
